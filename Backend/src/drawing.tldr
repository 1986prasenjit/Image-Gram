							},
							"content": [
								{
									"type": "text",
									"text": "business logic, it contains functions and classes "
								}
							]
						},
						{
							"type": "paragraph",
							"attrs": {
								"dir": "auto"
							},
							"content": [
								{
									"type": "text",
									"text": "which has all the logic required to complete a "
